load("@io_bazel_rules_go//go:def.bzl", "go_library")

go_library(
    name = "rules_nodejs",
    srcs = [
        "grpc_nodejs_library.go",
        "grpc_web_js_library.go",
        "js_library.go",
        "proto_nodejs_library.go",
        "proto_ts_library.go",
    ],
    importpath = "github.com/stackb/rules_proto/v4/pkg/rule/rules_nodejs",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/protoc",
        "@bazel_gazelle//config",
        "@bazel_gazelle//label",
        "@bazel_gazelle//resolve",
        "@bazel_gazelle//rule",
    ],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
    ] + glob(["*.go"]),
    visibility = ["//pkg:__pkg__"],
)
