load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rules_go",
    srcs = ["go_library.go"],
    importpath = "github.com/stackb/rules_proto/v4/pkg/rule/rules_go",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/protoc",
        "@bazel_gazelle//config",
        "@bazel_gazelle//label",
        "@bazel_gazelle//resolve",
        "@bazel_gazelle//rule",
    ],
)

go_test(
    name = "rules_go_test",
    srcs = ["go_library_test.go"],
    embed = [":rules_go"],
    deps = [
        "//pkg/protoc",
        "@bazel_gazelle//rule",
    ],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
    ] + glob(["*.go"]),
    visibility = ["//pkg:__pkg__"],
)
